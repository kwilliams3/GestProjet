{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node --env-file=.env src/index.js",
    "db:create": "node --env-file=.env scripts/db-create.js",
    "db:migrate": "node --env-file=.env scripts/migrate.js",
    "db:seed": "node --env-file=.env scripts/seed.js",
    "db:setup": "npm run db:create && npm run db:migrate && npm run db:seed",
    "test": "node --env-file=.env --test \"tests/**/*.test.js\"",
    "test:coverage": "node --env-file=.env --test --experimental-test-coverage \"--test-coverage-include=src/**\" \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
